# Copy this to .env.local and fill in your actual server URLs

# Set to false to use real backend
VITE_USE_MOCKS=false

# Your identity (IdentityServer / Duende) URL
VITE_IDENTITY_BASE_URL=http://localhost:7101

# Your SmartSchool API URL
VITE_API_BASE_URL=http://localhost:7001

# Default tenant ID
VITE_TENANT_ID=11111111-1111-1111-1111-111111111111
